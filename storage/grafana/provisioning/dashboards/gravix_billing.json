            "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
            "targets": [
                {
                    "datasource": { "type": "prometheus", "uid": "Prometheus" },
                    "expr": "sum(rate(gateway_billing_checkout_total[5m])) by (plan, interval)",
