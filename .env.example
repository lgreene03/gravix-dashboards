# Gravix Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Ingestion API key (required for authenticated ingestion; minimum 16 characters)
API_KEY=change-me-to-a-real-secret

# MinIO / S3 Storage
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=gravix
S3_ACCESS_KEY=admin
S3_SECRET_KEY=change-me-to-a-real-secret

# MinIO Root Credentials
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-to-a-real-secret

# Gateway JWT secret (required for tenant auth; minimum 32 characters)
JWT_SECRET=change-me-to-a-real-jwt-secret-at-least-32-chars

# Cube.js Configuration
# Dev mode disables auth and enables playground UI (set to true only for local dev)
CUBEJS_DEV_MODE=false
# API Secret (optional — leave empty to disable auth on dashboard queries)
CUBEJS_API_SECRET=

# Gateway Configuration
# GATEWAY_ADDR=:8091
# TENANT_DB_PATH=./data/gravix.db
# INGESTION_URL=http://localhost:8090

# CORS: comma-separated allowed origins (defaults to * for local dev)
# In production, set to your actual domain(s) — NEVER use * in production
# CORS_ALLOWED_ORIGINS=https://app.gravix.io

# TOTP encryption key: 32+ character secret for encrypting 2FA secrets
# MUST be separate from JWT_SECRET in production; if unset, falls back to JWT_SECRET (deprecated)
# TOTP_ENCRYPTION_KEY=change-me-to-a-unique-totp-secret-32-plus

# Base URL for email links (password reset, verification, invitations)
# BASE_URL=http://localhost:8000

# Email provider settings
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM_ADDRESS=noreply@gravix.io
# EMAIL_FROM_NAME=Gravix

# CAPTCHA secret key (optional — leave empty to disable CAPTCHA)
# CAPTCHA_SECRET_KEY=

# Trace sampling rate (0.0 to 1.0, default 0.01 = 1%)
# TRACE_SAMPLE_RATE=0.01

# Stripe Billing (optional — leave empty to disable billing features)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Monthly Stripe price IDs
# STRIPE_PRICE_FREE=
# STRIPE_PRICE_TEAM=
# STRIPE_PRICE_BUSINESS=
# STRIPE_PRICE_SCALE=
# STRIPE_PRICE_ENTERPRISE=

# Annual Stripe price IDs (20% discount — leave empty to disable annual billing per plan)
# STRIPE_PRICE_TEAM_ANNUAL=
# STRIPE_PRICE_BUSINESS_ANNUAL=
# STRIPE_PRICE_SCALE_ANNUAL=
# STRIPE_PRICE_ENTERPRISE_ANNUAL=

# Cube.js API URL (gateway queries Cube for dashboard data)
# CUBE_API_URL=http://localhost:4000/cubejs-api/v1/load

# Database Driver (sqlite or postgres; default: sqlite)
# DB_DRIVER=sqlite
# TENANT_DB_PATH=./data/gravix.db   # SQLite path (when DB_DRIVER=sqlite)
# DATABASE_URL=postgres://gravix:gravix@localhost:5432/gravix?sslmode=disable  # PostgreSQL (when DB_DRIVER=postgres)

# PostgreSQL (optional — used with docker-compose --profile postgres)
# POSTGRES_USER=gravix
# POSTGRES_PASSWORD=gravix
# POSTGRES_DB=gravix

# Log level (debug, info, warn, error)
# LOG_LEVEL=info

# Docker image tags (optional overrides for pinning versions)
# TRINO_IMAGE_TAG=351
# CUBE_IMAGE_TAG=v0.35
# NGINX_IMAGE_TAG=1.25-alpine
# PROMETHEUS_IMAGE_TAG=v2.51.0
# GRAFANA_IMAGE_TAG=10.4.0
# MINIO_IMAGE_TAG=RELEASE.2024-03-15T01-07-19Z
