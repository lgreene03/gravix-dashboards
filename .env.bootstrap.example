# Gravix Bootstrap Environment Configuration
#
# Minimal config for the bootstrap stack (docker-compose.bootstrap.yml).
# No S3/MinIO credentials needed — everything uses local disk storage.
#
# Copy this file to .env:
#   cp .env.bootstrap.example .env

# No API key here. The bootstrap stack runs ingestion and gateway in
# multi-tenant mode (TENANT_DB_PATH), which takes precedence over API_KEY and
# made this variable dead config. The key is now generated on first boot by the
# bootstrap-init container and written to:
#
#   data/api_key.txt          the key itself, mode 0600
#   data/dashboard_config.js  the same key, for the dashboard to load
#
# Nothing in this file needs editing before `docker compose up`.

# Cube.js Configuration
# Dev mode disables auth and enables playground UI (set to true only for local dev)
CUBEJS_DEV_MODE=false
# API Secret (optional — leave empty to disable auth on dashboard queries)
CUBEJS_API_SECRET=
