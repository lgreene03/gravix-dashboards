# ---------------------------------------------------------------------------
# Compiled binaries
#
# `go build ./cmd/foo` with no -o writes ./foo into the working directory, so
# every command in this repo needs covering by name. Build into bin/ instead:
#   go build -o bin/gravix ./cmd/cli
# ---------------------------------------------------------------------------
bin/
/badge_server
/bootstrap_seed
/checkboundary
/incidentaudit
/cli
/compaction
/demo_seed
/gateway
/gen
/gen_facts
/ingestion
/ingestion-service
/load-generator
/load_generator
/onboarding_gate
/purge
/request_metrics_minute
/rollup-job
/seed_tenants
/service_events_daily
/service_events_detail
/sink-writer
/status_page
/trial_expiry
gravix
*.o
*.a
*.so
*.exe
*.test

# ---------------------------------------------------------------------------
# Dependencies
#
# sdk/node/package-lock.json pins every version, so node_modules is fully
# reproducible with `npm ci` and has no business in version control.
# ---------------------------------------------------------------------------
node_modules/

# ---------------------------------------------------------------------------
# Data and local state
#
# Gravix stores facts on disk. None of it is source.
# ---------------------------------------------------------------------------
data/
storage/trino/data/
storage/cube/data/
cube/.cubestore/
*.db
*.db-shm
*.db-wal

# ---------------------------------------------------------------------------
# Build and test output
# ---------------------------------------------------------------------------
coverage.out
coverage.html
*.coverprofile
sbom.json
cube_resp.json
dist/

# ---------------------------------------------------------------------------
# Tooling scratch
# ---------------------------------------------------------------------------
.claude/worktrees/
.env
.env.local

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# The Express recipe installs against the in-repo SDK (`file:../../../sdk/node`),
# which CI links with `npm install --install-links`. A lock file pinning that
# path would be rewritten on every install and go stale against the SDK it
# points at, so the recipe deliberately has none.
examples/recipes/express/package-lock.json

# Python bytecode caches
__pycache__/
*.pyc
