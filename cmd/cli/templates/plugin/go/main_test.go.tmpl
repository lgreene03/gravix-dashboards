func TestHandlesOneCall(t *testing.T) {
	row := map[string]any{"service": "checkout", "request_count": 42}
	params, err := json.Marshal(batch{
		Dataset:  "metrics",
		EventDay: "2026-01-02",
		Rows:     []map[string]any{row},
	})
	if err != nil {
		t.Fatalf("encode batch: %v", err)
	}

	resp := handle(request{JSONRPC: "2.0", ID: 3, Method: "gravix.export", Params: params})
	if resp.Error != nil {
		t.Fatalf("export returned an error: %+v", resp.Error)
	}
	res, ok := resp.Result.(map[string]any)
	if !ok {
		t.Fatalf("export result = %T, want an object", resp.Result)
	}
	if got := res["rows_written"]; got != int64(1) {
		t.Errorf("rows_written = %v, want 1", got)
	}
	if res["destination"] == "" {
		t.Error("destination is empty; it is what logs and `gravix doctor` show")
	}
}
{{end}}{{if eq .Kind "adapter"}}
func TestHandlesOneCall(t *testing.T) {
	fact := requestFact{
		EventID:      "0190000000007000800000000000000a",
		EventTime:    "2026-01-02T03:04:05Z",
		Service:      "checkout",
		Method:       "GET",
		PathTemplate: "/orders/{id}",
		StatusCode:   200,
		LatencyMs:    12,
	}
	payload, err := json.Marshal([]requestFact{fact})
	if err != nil {
		t.Fatalf("encode payload: %v", err)
	}
	params, err := json.Marshal(convertParams{Payload: payload, ContentType: "application/json"})
	if err != nil {
		t.Fatalf("encode params: %v", err)
	}

	resp := handle(request{JSONRPC: "2.0", ID: 3, Method: "gravix.convert", Params: params})
	if resp.Error != nil {
		t.Fatalf("convert returned an error: %+v", resp.Error)
	}
	facts, ok := resp.Result.([]requestFact)
	if !ok {
		t.Fatalf("convert result = %T, want facts", resp.Result)
	}
	if len(facts) != 1 {
		t.Fatalf("got %d facts, want 1", len(facts))
	}
	// Gravix drops facts whose path carries a raw id, so a converter that
	// emits them loses data rather than getting it in.
	if facts[0].PathTemplate != "/orders/{id}" {
		t.Errorf("path_template = %q, want a templated path", facts[0].PathTemplate)
	}
}

func TestUnsupportedContentTypeIsRejected(t *testing.T) {
	params, err := json.Marshal(convertParams{Payload: []byte("<xml/>"), ContentType: "application/xml"})
	if err != nil {
		t.Fatalf("encode params: %v", err)
	}
	if resp := handle(request{JSONRPC: "2.0", ID: 4, Method: "gravix.convert", Params: params}); resp.Error == nil {
		t.Fatal("an unsupported content type was accepted")
	}
}
