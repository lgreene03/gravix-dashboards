# Gravix Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Ingestion API key (required for authenticated ingestion)
API_KEY=change-me-to-a-real-secret

# MinIO / S3 Storage
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=gravix
S3_ACCESS_KEY=admin
S3_SECRET_KEY=change-me-to-a-real-secret

# MinIO Root Credentials
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-to-a-real-secret

# Cube.js Configuration
# Dev mode disables auth and enables playground UI (set to true only for local dev)
CUBEJS_DEV_MODE=false
# API Secret (optional — leave empty to disable auth on dashboard queries)
CUBEJS_API_SECRET=

# Docker image tags (optional overrides for pinning versions)
# TRINO_IMAGE_TAG=351
# CUBE_IMAGE_TAG=v0.35
# NGINX_IMAGE_TAG=1.25-alpine
# PROMETHEUS_IMAGE_TAG=v2.51.0
# GRAFANA_IMAGE_TAG=10.4.0
# MINIO_IMAGE_TAG=RELEASE.2024-03-15T01-07-19Z
